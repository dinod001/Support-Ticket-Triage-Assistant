# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=triage_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/triage_db

# LLM Provider Configuration ('ollama', 'groq', or 'gemini')
LLM_PROVIDER=ollama

# Ollama Configuration (Local Default)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional Hosted Cloud Providers (Leave empty when using local Ollama)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Backend Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development
