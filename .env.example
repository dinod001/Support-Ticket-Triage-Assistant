# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env and adjust as necessary: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL in Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=triage_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/triage_db

# LLM Provider Configuration ('ollama' for local default, or 'groq' for optional cloud)
LLM_PROVIDER=ollama

# Ollama Local Service Configuration (Zero API Key Reviewer Setup)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60.0

# Optional Cloud LLM Provider (Groq Free Tier)
# If provided and LLM_PROVIDER=groq, the app routes triage & RAG drafting through Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Cloud LLM Provider (Google Gemini Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Application Ports & Environment
BACKEND_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=production
DEBUG=false
